# Port HTTP
PORT=3000
# URL publique (utilisée pour les retours Stripe). Ex: https://misschaudelinks.com
PUBLIC_URL=http://localhost:3000
# Paiements réels : clé secrète Stripe (sk_live_... ou sk_test_...).
# Sans clé, l'app tourne en MODE DÉMO (achats simulés, marqués "démo").
STRIPE_SECRET_KEY=
# Devise des paiements
CURRENCY=eur
# Secret pour signer les cookies (mettre une longue chaîne aléatoire en prod)
COOKIE_SECRET=change-moi
