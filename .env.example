# ─────────────────────────────────────────────────────────────────────────────
# Miaamm : variables d'environnement
# Copier en .env.local (ignoré par Git) et remplir. Ne jamais committer de secret.
# Chaque variable est validée par Zod dans src/lib/env.ts.
# ─────────────────────────────────────────────────────────────────────────────

# URL publique de l'app (sans slash final)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Domaine racine des boutiques : {slug}.<domaine> → /s/{slug}. En local : localhost:3000
NEXT_PUBLIC_ROOT_DOMAIN=localhost:3000

# ── Supabase (phase 1) ──────────────────────────────────────────────────────
# Dashboard Supabase > Project Settings > API, ou `supabase status` en local.
# Valeurs ci-dessous = clés de DÉVELOPPEMENT publiques de la Supabase CLI (supabase start / pnpm supabase:lite).
# En production : Dashboard Supabase > Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0
# Contourne la RLS : serveur uniquement (webhooks, crons). Ne jamais préfixer NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hdp7fsn3W0YpN81IU

# Connexion Postgres directe : tests SQL (pnpm test:db) et génération des types.
# Base locale « nue » recréée par pnpm db:reset (shim Supabase + migrations + seed).
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/miaamm_test

# ── Chiffrement des clés API restaurateur (Shipday, Stuart…) ────────────────
# 32 octets en base64. Générer avec : openssl rand -base64 32
MIAAMM_ENCRYPTION_KEY=

# ── Paiements (phase 3) ─────────────────────────────────────────────────────
# mock   : paiement simulé (dev, E2E), aucune clé nécessaire. Interdit en production Vercel.
# stripe : Stripe Connect, direct charges sur le compte du restaurateur, sans commission.
# Sans valeur : stripe si STRIPE_SECRET_KEY est défini, sinon mock.
MIAAMM_PAYMENTS_MODE=mock
# Dashboard Stripe (compte plateforme Miaamm) > Développeurs > Clés API. Utiliser les clés test en dev.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Secret de l'endpoint webhook « Connect » (événements des comptes connectés) pointant vers
# <APP_URL>/api/webhooks/stripe, avec : payment_intent.succeeded, payment_intent.payment_failed,
# account.updated. En local : stripe listen --forward-connect-to localhost:3000/api/webhooks/stripe
STRIPE_WEBHOOK_SECRET=

# ── Onboarding (phase 4) ────────────────────────────────────────────────────
# Géocodage des adresses : Géoplateforme IGN (sans clé). mock = coordonnées fixes
# (dev, E2E hors ligne), interdit en production Vercel.
MIAAMM_GEOCODER=mock
# Import de carte depuis une photo ou un PDF (API Claude). Sans clé, l'option est masquée.
# console.anthropic.com > API Keys. mock = carte d'exemple (dev, E2E), interdit en production.
ANTHROPIC_API_KEY=
MIAAMM_AI_IMPORT=mock

# ── Notifications (phase 5) ─────────────────────────────────────────────────
# mock : emails et notifications écrits dans MIAAMM_OUTBOX_DIR (dev, E2E), interdit en production.
MIAAMM_EMAIL_MODE=mock
MIAAMM_PUSH_MODE=mock
# MIAAMM_OUTBOX_DIR=.tools/outbox
# Emails transactionnels : resend.com > API Keys ; domaine d'envoi vérifié dans Resend.
RESEND_API_KEY=
RESEND_FROM=Miaamm <commandes@miaamm.app>
# Web Push (alertes de nouvelles commandes) : générer une fois avec `npx web-push generate-vapid-keys`.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contact@miaamm.app

# ── À venir ─────────────────────────────────────────────────────────────────
# Phase 6 : NEXT_PUBLIC_MAPBOX_TOKEN, MAPBOX_SECRET_TOKEN
# Phase 8 : UBER_DIRECT_*, STUART_* (sandbox)

# ── Tests E2E (optionnel) ───────────────────────────────────────────────────
# Chemin d'un Chromium préinstallé (sinon Playwright utilise le sien).
# PW_CHROMIUM_PATH=/opt/pw-browsers/chromium
# E2E_PORT=3100
