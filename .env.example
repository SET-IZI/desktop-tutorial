# ─────────────────────────────────────────────────────────────────────────────
# Miaamm : variables d'environnement
# Copier en .env.local (ignoré par Git) et remplir. Ne jamais committer de secret.
# Chaque variable est validée par Zod dans src/lib/env.ts.
# ─────────────────────────────────────────────────────────────────────────────

# URL publique de l'app (sans slash final)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Supabase (phase 1) ──────────────────────────────────────────────────────
# Dashboard Supabase > Project Settings > API, ou `supabase status` en local.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Contourne la RLS : serveur uniquement (webhooks, crons). Ne jamais préfixer NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# ── Chiffrement des clés API restaurateur (Shipday, Stuart…) ────────────────
# 32 octets en base64. Générer avec : openssl rand -base64 32
MIAAMM_ENCRYPTION_KEY=

# ── À venir ─────────────────────────────────────────────────────────────────
# Phase 3 : STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET, NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY
# Phase 5 : RESEND_API_KEY, VAPID_PUBLIC_KEY, VAPID_PRIVATE_KEY
# Phase 6 : NEXT_PUBLIC_MAPBOX_TOKEN, MAPBOX_SECRET_TOKEN
# Phase 8 : UBER_DIRECT_*, STUART_* (sandbox)

# ── Tests E2E (optionnel) ───────────────────────────────────────────────────
# Chemin d'un Chromium préinstallé (sinon Playwright utilise le sien).
# PW_CHROMIUM_PATH=/opt/pw-browsers/chromium
# E2E_PORT=3100
